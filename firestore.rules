rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function boundedText(value, maximum) { return value is string && value.size() <= maximum; }
    function cents(value) { return value is int && value > 0 && value <= 100000000000; }
    function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function ownerValid(uid) { return request.resource.data.ownerUid == uid; }
    function previousOwnerValid(uid) { return !('ownerUid' in resource.data) || resource.data.ownerUid == uid; }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'displayName', 'mobileNumber', 'phone', 'birthday', 'birthdate', 'address', 'email', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && boundedText(request.resource.data.displayName, 120)
        && boundedText(request.resource.data.address, 500);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'photoURL', 'isBiometricEnabled', 'isNotificationEnabled', 'updatedAt', 'ownerUid'])
        && (!('ownerUid' in request.resource.data) || ownerValid(userId))
        && (!('displayName' in request.resource.data) || boundedText(request.resource.data.displayName, 120))
        && (!('phone' in request.resource.data) || boundedText(request.resource.data.phone, 32))
        && (!('address' in request.resource.data) || boundedText(request.resource.data.address, 500))
        && (!('photoURL' in request.resource.data) || boundedText(request.resource.data.photoURL, 700000))
        && (!('isBiometricEnabled' in request.resource.data) || request.resource.data.isBiometricEnabled is bool)
        && (!('isNotificationEnabled' in request.resource.data) || request.resource.data.isNotificationEnabled is bool);

      match /transactions/{transactionId} {
        function ordinaryFields() {
          return boundedText(request.resource.data.name, 200)
            && boundedText(request.resource.data.category, 100)
            && cents(request.resource.data.amountCentavos)
            && request.resource.data.amount is number
            && request.resource.data.amount == request.resource.data.amountCentavos / 100
            && request.resource.data.type in ['Income', 'Expense', 'Transfer', 'Opening Balance']
            && date(request.resource.data.date)
            && request.resource.data.time is string;
        }
        allow read: if owns(userId);
        // Confirmed installments are written only by the authenticated backend.
        allow create: if owns(userId) && ownerValid(userId) && ordinaryFields()
          && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'category', 'amount', 'amountCentavos', 'type', 'date', 'time', 'loanId', 'createdAt', 'updatedAt'])
          && request.resource.data.loanId == null
          && !transactionId.matches('^payment_.*');
        allow update: if owns(userId) && previousOwnerValid(userId) && ownerValid(userId) && ordinaryFields()
          && !('confirmedPayment' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'name', 'category', 'amount', 'amountCentavos', 'type', 'date', 'time', 'updatedAt']);
        allow delete: if owns(userId) && previousOwnerValid(userId) && !('confirmedPayment' in resource.data);
      }

      match /loans/{loanId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && ownerValid(userId)
          && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'title', 'principalCentavos', 'installmentCentavos', 'durationMonths', 'dueDay', 'startDate', 'firstDueDate', 'endDate', 'createdAt'])
          && request.resource.data.schemaVersion == 2
          && boundedText(request.resource.data.title, 200)
          && cents(request.resource.data.principalCentavos) && cents(request.resource.data.installmentCentavos)
          && request.resource.data.durationMonths is int && request.resource.data.durationMonths >= 1 && request.resource.data.durationMonths <= 600
          && request.resource.data.dueDay is int && request.resource.data.dueDay >= 1 && request.resource.data.dueDay <= 31
          && date(request.resource.data.startDate) && date(request.resource.data.firstDueDate) && date(request.resource.data.endDate)
          && request.resource.data.firstDueDate >= request.resource.data.startDate
          && request.resource.data.endDate >= request.resource.data.firstDueDate;
        // Legacy conversion and payment-sensitive edits require a reviewed backend workflow.
        allow update, delete: if false;
      }

      match /cards/{cardId} {
        function cardFields() {
          return boundedText(request.resource.data.name, 120)
            && request.resource.data.type in ['Debit', 'Credit']
            && request.resource.data.lastFour is string && request.resource.data.lastFour.matches('^[0-9]{4}$')
            && request.resource.data.expiry is string && request.resource.data.expiry.matches('^(0[1-9]|1[0-2])/[0-9]{2}$')
            && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000;
        }
        allow read: if owns(userId);
        allow create: if owns(userId) && ownerValid(userId) && cardFields()
          && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'type', 'lastFour', 'expiry', 'amount', 'createdAt', 'updatedAt']);
        allow update: if owns(userId) && previousOwnerValid(userId) && ownerValid(userId) && cardFields()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'name', 'type', 'lastFour', 'expiry', 'amount', 'updatedAt']);
        allow delete: if owns(userId) && previousOwnerValid(userId);
      }

      match /credit_scores/{scoreId} {
        allow read: if owns(userId);
        // Local heuristic only, never a bureau-verified score.
        allow create, update: if owns(userId) && ownerValid(userId)
          && request.resource.data.keys().hasOnly(['ownerUid', 'userId', 'score', 'tier', 'paymentHistoryScore', 'creditUtilizationPct', 'isEstimated', 'updatedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.isEstimated == true
          && request.resource.data.score is int && request.resource.data.score >= 300 && request.resource.data.score <= 850
          && request.resource.data.tier in ['Excellent', 'Good', 'Fair', 'Poor']
          && request.resource.data.paymentHistoryScore is number
          && request.resource.data.creditUtilizationPct is number;
      }
    }
    // No top-level financial collections, service limits or unrelated access.
    match /{document=**} { allow read, write: if false; }
  }
}
