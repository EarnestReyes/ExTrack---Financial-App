{
  "expo": {
    "name": "ExTrack",
    "slug": "extrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "extrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow ExTrack to use Face ID to secure your account.",
        "NSCameraUsageDescription": "Allow ExTrack to access your camera to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow ExTrack to access your photo library to select a profile picture."
      }
    },
    "android": {
      "package": "com.extrack.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tabIcons/icons8-general-ledger-100.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0556A1",
          "image": "./assets/images/tabIcons/icons8-general-ledger-100.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ExTrack to use Face ID to secure your account."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ExTrack to access your photos to select a profile picture.",
          "cameraPermission": "Allow ExTrack to access your camera to take a profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3b82f6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b55a172b-4217-4a7e-a1f6-d63736c51bdf"
      }
    }
  }
}